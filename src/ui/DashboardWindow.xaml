<Window x:Class="Keymon.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="집중력 가이드 대시보드" Height="900" Width="720"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC"
        ResizeMode="NoResize">

	<Window.Resources>
		<SineEase x:Key="SineEase" EasingMode="EaseInOut"/>
		<Storyboard x:Key="AnimIdle" RepeatBehavior="Forever">
			<DoubleAnimation Storyboard.TargetName="CharScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.05" Duration="0:0:2" AutoReverse="True" EasingFunction="{StaticResource SineEase}"/>
			<DoubleAnimation Storyboard.TargetName="CharScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.05" Duration="0:0:2" AutoReverse="True" EasingFunction="{StaticResource SineEase}"/>
		</Storyboard>
		<Storyboard x:Key="AnimDistracted" RepeatBehavior="Forever">
			<DoubleAnimation Storyboard.TargetName="CharRotate" Storyboard.TargetProperty="Angle" From="-15" To="15" Duration="0:0:0.5" AutoReverse="True"/>
			<DoubleAnimation Storyboard.TargetName="CharTranslate" Storyboard.TargetProperty="X" From="-5" To="5" Duration="0:0:0.3" AutoReverse="True"/>
		</Storyboard>
		<Storyboard x:Key="AnimEngaged" RepeatBehavior="Forever">
			<DoubleAnimation Storyboard.TargetName="CharRotate" Storyboard.TargetProperty="Angle" From="-3" To="3" Duration="0:0:1" AutoReverse="True" EasingFunction="{StaticResource SineEase}"/>
		</Storyboard>
		<Storyboard x:Key="AnimFocused" RepeatBehavior="Forever">
			<DoubleAnimation Storyboard.TargetName="CharTranslate" Storyboard.TargetProperty="Y" From="0" To="-5" Duration="0:0:0.8" AutoReverse="True" EasingFunction="{StaticResource SineEase}"/>
		</Storyboard>
		<Storyboard x:Key="AnimDeepFocus" RepeatBehavior="Forever">
			<DoubleAnimation Storyboard.TargetName="CharTranslate" Storyboard.TargetProperty="Y" From="-2" To="2" Duration="0:0:0.1" AutoReverse="True"/>
			<DoubleAnimation Storyboard.TargetName="CharScale" Storyboard.TargetProperty="ScaleX" From="1.1" To="1.15" Duration="0:0:0.2" AutoReverse="True"/>
			<DoubleAnimation Storyboard.TargetName="CharScale" Storyboard.TargetProperty="ScaleY" From="1.1" To="1.15" Duration="0:0:0.2" AutoReverse="True"/>
		</Storyboard>

		<Style x:Key="CardStyle" TargetType="Border">
			<Setter Property="Background" Value="White"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="20"/>
			<Setter Property="Margin" Value="0,0,0,15"/>
			<Setter Property="BorderBrush" Value="#E2E8F0"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect Color="#E2E8F0" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="0,0,0,15" HorizontalAlignment="Center">
			<TextBlock x:Name="TxtStatus" Text="나의 집중 패턴 모니터링" FontSize="22" FontWeight="Heavy" Foreground="#1E293B" HorizontalAlignment="Center" TextAlignment="Center"/>
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
				<TextBlock Text="⏱️ 다음 상태 갱신:" FontSize="13" Foreground="#64748B" Margin="0,0,8,0" VerticalAlignment="Center"/>
				<Border CornerRadius="3" Background="#E2E8F0" ClipToBounds="True" Height="6" Width="150" VerticalAlignment="Center">
					<ProgressBar x:Name="BarUpdate" Value="60" Maximum="60" Foreground="#3B82F6" Background="Transparent" BorderThickness="0"/>
				</Border>
				<TextBlock x:Name="TxtUpdateSec" Text="60초" FontSize="13" FontWeight="Bold" Foreground="#3B82F6" Margin="8,0,0,0" Width="30" VerticalAlignment="Center"/>
			</StackPanel>
		</StackPanel>

		<TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
			<TabControl.Resources>
				<Style TargetType="TabItem">
					<Setter Property="FontSize" Value="15"/>
					<Setter Property="FontWeight" Value="SemiBold"/>
					<Setter Property="Padding" Value="20,10"/>
					<Setter Property="Margin" Value="0,0,5,15"/>
					<Setter Property="Foreground" Value="#64748B"/>
					<Style.Triggers>
						<Trigger Property="IsSelected" Value="True">
							<Setter Property="Foreground" Value="#3B82F6"/>
						</Trigger>
					</Style.Triggers>
				</Style>
			</TabControl.Resources>

			<TabItem Header="⏱️ 실시간 모니터링">
				<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
					<StackPanel>
						<Border Background="White" CornerRadius="20" Margin="0,0,0,15" Padding="20">
							<Border.Effect>
								<DropShadowEffect x:Name="CharGlow" Color="#E2E8F0" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
							</Border.Effect>
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<TextBlock x:Name="TxtCharacter" Text="⏳" FontSize="80" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" Margin="0,0,0,15">
									<TextBlock.RenderTransform>
										<TransformGroup>
											<ScaleTransform x:Name="CharScale" ScaleX="1" ScaleY="1"/>
											<RotateTransform x:Name="CharRotate" Angle="0"/>
											<TranslateTransform x:Name="CharTranslate" X="0" Y="0"/>
										</TransformGroup>
									</TextBlock.RenderTransform>
								</TextBlock>
								<TextBlock x:Name="TxtStateTitle" Text="패턴 분석 준비" FontSize="32" FontWeight="Heavy" Foreground="#475569" HorizontalAlignment="Center"/>
								<TextBlock x:Name="TxtCharState" Text="데이터를 불러오고 있습니다..." FontSize="16" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,10,0,0"/>
								<Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,15,0,0" Width="500">
									<StackPanel>
										<TextBlock Text="💡 데이터 기반 상태 진단" FontWeight="Bold" FontSize="13" Foreground="#475569" Margin="0,0,0,8"/>
										<TextBlock x:Name="TxtReason" Text="데이터를 수집하여 판단 근거를 분석하고 있습니다..." FontSize="13" Foreground="#64748B" TextWrapping="Wrap" LineHeight="18"/>
									</StackPanel>
								</Border>
							</StackPanel>
						</Border>
						<Border Background="White" CornerRadius="10" Padding="15,25,15,25">
							<UniformGrid Columns="4" Rows="2">
								<StackPanel HorizontalAlignment="Center" Margin="0,0,0,25">
									<TextBlock Text="🔥 타수 (KPM)" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
									<TextBlock x:Name="TxtKpm" Text="0" FontSize="26" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5,0,0"/>
								</StackPanel>
								<StackPanel HorizontalAlignment="Center" Margin="0,0,0,25">
									<TextBlock Text="🖱️ 클릭 (MPM)" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
									<TextBlock x:Name="TxtMpm" Text="0" FontSize="26" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5,0,0"/>
								</StackPanel>
								<StackPanel HorizontalAlignment="Center" Margin="0,0,0,25">
									<TextBlock Text="⚡ 총 행동 (APM)" Foreground="#94A3B8" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
									<TextBlock x:Name="TxtApm" Text="0" FontSize="26" FontWeight="Heavy" Foreground="#8B5CF6" HorizontalAlignment="Center" Margin="0,5,0,0"/>
								</StackPanel>
								<StackPanel HorizontalAlignment="Center" Margin="0,0,0,25">
									<TextBlock Text="🎯 최종 집중도" Foreground="#94A3B8" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
									<TextBlock x:Name="TxtFocus" Text="0%" FontSize="26" FontWeight="Heavy" Foreground="#3B82F6" HorizontalAlignment="Center" Margin="0,5,0,0"/>
								</StackPanel>
								<StackPanel HorizontalAlignment="Center">
									<TextBlock Text="🔙 오타율" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
									<TextBlock x:Name="TxtEr" Text="0 회" FontSize="22" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,5,0,0"/>
								</StackPanel>
								<StackPanel HorizontalAlignment="Center">
									<TextBlock Text="🔀 창 전환" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
									<TextBlock x:Name="TxtCsr" Text="0 번" FontSize="22" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,5,0,0"/>
								</StackPanel>
								<StackPanel HorizontalAlignment="Center">
									<TextBlock Text="💢 거친 꺾임" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
									<TextBlock x:Name="TxtJerk" Text="0 회" FontSize="22" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,5,0,0"/>
								</StackPanel>
								<StackPanel HorizontalAlignment="Center">
									<TextBlock Text="😴 누적 피로도" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
									<TextBlock x:Name="TxtFatigue" Text="0 %" FontSize="22" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,5,0,0"/>
								</StackPanel>
							</UniformGrid>
						</Border>
					</StackPanel>
				</ScrollViewer>
			</TabItem>

			<TabItem Header="📊 통계 및 분석">
				<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
					<StackPanel>
						<Border Style="{StaticResource CardStyle}" Margin="0,5,0,15">
							<StackPanel>
								<TextBlock Text="📅 날짜 선택" FontWeight="Bold" FontSize="14" Foreground="#64748B" Margin="0,0,0,15"/>
								<StackPanel x:Name="DatePanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
							</StackPanel>
						</Border>

						<Border Style="{StaticResource CardStyle}">
							<StackPanel>
								<TextBlock x:Name="TxtDailyReportTitle" Text="📋 0월 0일 리포트" FontWeight="Bold" FontSize="14" Foreground="#64748B" Margin="0,0,0,10"/>
								<TextBlock x:Name="TxtSummarySentence" Text="데이터를 불러오는 중입니다..." FontWeight="Heavy" FontSize="20" Foreground="#1E293B" Margin="0,0,0,20" HorizontalAlignment="Center" TextWrapping="Wrap"/>

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<Border Grid.Column="0" Background="#F0F9FF" CornerRadius="8" Padding="12" Margin="0,0,5,0">
										<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
											<TextBlock Text="◎" FontSize="20" Foreground="#3B82F6" Margin="0,0,8,0" VerticalAlignment="Center"/>
											<StackPanel VerticalAlignment="Center">
												<TextBlock Text="평균 집중도" FontSize="11" Foreground="#64748B"/>
												<TextBlock x:Name="TxtDailyAvgFocus" Text="-" FontSize="18" FontWeight="Bold" Foreground="#3B82F6"/>
											</StackPanel>
										</StackPanel>
									</Border>
									<Border Grid.Column="1" Background="#FFFBEB" CornerRadius="8" Padding="12" Margin="3,0,3,0">
										<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
											<TextBlock Text="📈" FontSize="20" Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
											<StackPanel VerticalAlignment="Center">
												<TextBlock Text="평균 피로도" FontSize="11" Foreground="#64748B"/>
												<TextBlock x:Name="TxtDailyAvgFatigue" Text="-" FontSize="18" FontWeight="Bold" Foreground="#F59E0B"/>
											</StackPanel>
										</StackPanel>
									</Border>
									<Border Grid.Column="2" Background="#ECFDF5" CornerRadius="8" Padding="12" Margin="3,0,3,0">
										<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
											<TextBlock Text="🕒" FontSize="20" Foreground="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
											<StackPanel VerticalAlignment="Center">
												<TextBlock Text="총 집중 시간" FontSize="11" Foreground="#64748B"/>
												<TextBlock x:Name="TxtDailyWorkTime" Text="-" FontSize="16" FontWeight="Bold" Foreground="#10B981"/>
											</StackPanel>
										</StackPanel>
									</Border>
									<Border Grid.Column="3" Background="#F1F5F9" CornerRadius="8" Padding="12" Margin="5,0,0,0">
										<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
											<TextBlock Text="☕" FontSize="20" Foreground="#64748B" Margin="0,0,8,0" VerticalAlignment="Center"/>
											<StackPanel VerticalAlignment="Center">
												<TextBlock Text="대기 시간" FontSize="11" Foreground="#64748B"/>
												<TextBlock x:Name="TxtDailyIdleTime" Text="-" FontSize="16" FontWeight="Bold" Foreground="#64748B"/>
											</StackPanel>
										</StackPanel>
									</Border>
								</Grid>
							</StackPanel>
						</Border>

						<Border Style="{StaticResource CardStyle}">
							<StackPanel>
								<Grid Margin="0,0,0,15">
									<TextBlock Text="📈 선택한 날짜의 시간대별 흐름" FontWeight="Bold" FontSize="14" Foreground="#64748B"/>
									<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
										<Ellipse Width="10" Height="10" Fill="#3B82F6" Margin="0,0,5,0"/>
										<TextBlock Text="집중도" FontSize="12" Foreground="#64748B" Margin="0,0,15,0"/>
										<Ellipse Width="10" Height="10" Fill="#F59E0B" Margin="0,0,5,0"/>
										<TextBlock Text="피로도" FontSize="12" Foreground="#64748B"/>
									</StackPanel>
								</Grid>

								<Grid Height="160" Margin="10,0,10,0">
									<Line X1="0" Y1="10" X2="580" Y2="10" Stroke="#E2E8F0" StrokeThickness="1"/>
									<Line X1="0" Y1="75" X2="580" Y2="75" Stroke="#E2E8F0" StrokeThickness="1"/>
									<Line X1="0" Y1="140" X2="580" Y2="140" Stroke="#E2E8F0" StrokeThickness="1"/>

									<TextBlock Text="100" FontSize="10" Foreground="#94A3B8" Margin="-20,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
									<TextBlock Text="50" FontSize="10" Foreground="#94A3B8" Margin="-15,69,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
									<TextBlock Text="0" FontSize="10" Foreground="#94A3B8" Margin="-10,134,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

									<Canvas x:Name="DailyChartCanvas" Width="580" Height="150" HorizontalAlignment="Center" ClipToBounds="False"/>
								</Grid>
								<Grid x:Name="DailyChartXAxis" Height="20" Margin="10,5,10,0" Width="580" HorizontalAlignment="Center"/>
							</StackPanel>
						</Border>

						<Grid Margin="0,0,0,10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="1.1*"/>
								<ColumnDefinition Width="15"/>
								<ColumnDefinition Width="1*"/>
							</Grid.ColumnDefinitions>

							<Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
								<StackPanel x:Name="StateDistributionPanel"/>
							</Border>

							<Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
								<StackPanel>
									<TextBlock Text="💡 그날의 힌트" FontWeight="Bold" FontSize="14" Foreground="#64748B" Margin="0,0,0,15"/>

									<Border Background="#F0FDF4" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#DCFCE7" BorderThickness="1">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto"/>
												<ColumnDefinition Width="*"/>
											</Grid.ColumnDefinitions>
											<TextBlock Grid.Column="0" Text="📈" FontSize="20" VerticalAlignment="Top" Margin="0,0,10,0"/>
											<StackPanel Grid.Column="1">
												<TextBlock x:Name="TxtDailyHint1Title" Text="데이터 분석 중" FontWeight="Bold" FontSize="13" Foreground="#166534" Margin="0,0,0,4"/>
												<TextBlock x:Name="TxtDailyHint1Desc" Text="충분한 데이터가 누적되면 맞춤형 힌트가 제공됩니다." FontSize="12" Foreground="#15803D" TextWrapping="Wrap"/>
											</StackPanel>
										</Grid>
									</Border>

									<Border Background="#FFF7ED" CornerRadius="8" Padding="12" BorderBrush="#FFEDD5" BorderThickness="1">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto"/>
												<ColumnDefinition Width="*"/>
											</Grid.ColumnDefinitions>
											<TextBlock Grid.Column="0" Text="📉" FontSize="20" VerticalAlignment="Top" Margin="0,0,10,0"/>
											<StackPanel Grid.Column="1">
												<TextBlock x:Name="TxtDailyHint2Title" Text="데이터 분석 중" FontWeight="Bold" FontSize="13" Foreground="#C2410C" Margin="0,0,0,4"/>
												<TextBlock x:Name="TxtDailyHint2Desc" Text="작업 세션이 종료되면 인지적 피로 흐름을 분석합니다." FontSize="12" Foreground="#B45309" TextWrapping="Wrap"/>
											</StackPanel>
										</Grid>
									</Border>
								</StackPanel>
							</Border>
						</Grid>
					</StackPanel>
				</ScrollViewer>
			</TabItem>
		</TabControl>
	</Grid>
</Window>